<section class="section" id="services">
  <h2>Services</h2>
  <p class="lead">
    Choose one-on-one coaching or train with a partner. Programs are sold as session packages,
    and each one includes nutrition guidance.
  </p>
  <div class="card-grid">
    <article class="card">
      <h3>Private weight training</h3>
      <p class="card-meta">1 person · packages of 10, 20, 30, 40 or 50 sessions</p>
      <ul>
        <li>Muscle conditioning and weight loss</li>
        <li>3–4 sessions per week</li>
        <li>Fully individualized program</li>
        <li>Nutrition education and progress monitoring</li>
      </ul>
    </article>
    <article class="card">
      <h3>Partner weight training</h3>
      <p class="card-meta">2 people · packages of 10, 20, 30, 40 or 50 sessions</p>
      <ul>
        <li>Muscle toning and weight loss</li>
        <li>2–3 sessions per week</li>
        <li>Individualized program for each partner</li>
        <li>Nutrition education and progress monitoring</li>
      </ul>
    </article>
