---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.PNG';
---

<section class="hero">
  <Image
    src={heroImage}
    widths={[640, 1024, 1334]}
    sizes="100vw"
    alt="Athletes training kickboxing pads at RenoFitness"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-overlay"></div>
  <div class="hero-copy">
    <h1>RenoFitness in YYC</h1>
    <p>Fat loss, muscle toning, and strength training for busy people — plus fitness kickboxing and Muay Thai.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/contact">I'm ready</a>
      <a class="btn btn-ghost" href="#about">Learn more</a>
    </div>
  </div>
</section>
