---
import { whatsappUrl } from '../scripts/whatsapp.js';
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <h2>RenoFitness</h2>
      <p>Personal training in Calgary (YYC).</p>
      <ul class="socials">
        <li><a href="https://www.facebook.com/renofitness/" aria-label="Facebook">f</a></li>
        <li><a href="https://twitter.com/llgg716?lang=en" aria-label="X">x</a></li>
        {whatsappUrl && (
          <li><a href={whatsappUrl} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">wa</a></li>
        )}
      </ul>
    </div>
    <div>
      <h3>Explore</h3>
      <p><a href="/#about">About</a></p>
      <p><a href="/blog">Blog</a></p>
      <p><a href="/contact">Contact</a></p>
      <p><a href="/subscribe">Newsletter</a></p>
    </div>
    <div>
      <h3>Stay in touch</h3>
      <p>Training notes and studio updates, straight to your inbox.</p>
      <p><a class="btn btn-primary" href="/subscribe">Join the newsletter</a></p>
    </div>
  </div>
  <div class="footer-meta">
    <p>&copy; 2018–2026 Reno Fitness. All rights reserved.</p>
