# ============================================================================
# RenoFitness build settings
# Copy this file to .env for local builds. Every value here ends up in the
# public site, so never put a password or secret key in it.
# For the live site, set the same names as GitHub repository variables
# (Settings → Secrets and variables → Actions → Variables).
# All values are read at build time: rebuild or restart `npm run dev` after changing them.
# ============================================================================

# Formspree form ID, the part after /f/ in the form's endpoint (e.g. xyzabcd).
# Leave empty to show social links instead of the contact form.
PUBLIC_FORMSPREE_FORM_ID=

# Hosted signup form URL from the email-marketing service (Brevo: Forms → Share → link).
# Must start with https://. Leave empty to show "signup opens soon".
PUBLIC_NEWSLETTER_FORM_URL=

# WhatsApp number with country code, digits only (e.g. 1403xxxxxxx).
# Leave empty to hide the WhatsApp chat button and links.
PUBLIC_WHATSAPP_NUMBER=

# Optional analytics — omit to skip tags
PUBLIC_GTM_ID=
PUBLIC_GA_ID=
