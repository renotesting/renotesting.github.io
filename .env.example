# ============================================================================
# RenoFitness Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - it contains sensitive information!
# ============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Public address of the site, used for links in emails (no trailing slash)
SITE_URL=http://localhost:3000

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
# Generate a strong secret key (minimum 32 characters)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-this-to-something-long-and-random

# JWT Token expiration (e.g., "7d", "24h", "30m")
JWT_EXPIRATION=7d

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# For Gmail:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the app password below (16 characters with spaces)

# Email provider (gmail, outlook, custom)
EMAIL_PROVIDER=gmail

# Sender email address
EMAIL_USER=your-email@gmail.com

# App-specific password (NOT your regular Gmail password!)
# For Gmail: Use the 16-character password from App Passwords
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Receives contact form notifications. Doesn't grant admin access: see "npm run make-admin"
ADMIN_EMAIL=RenoStudio@hotmail.com

# Email settings
EMAIL_FROM_NAME=RenoFitness

# Only used when EMAIL_PROVIDER=custom
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Number of salt rounds for bcryptjs password hashing
BCRYPT_ROUNDS=10

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:4321,http://localhost:3000

# Number of reverse proxies in front of the app, so rate limits see real visitor IPs.
# 0 when running directly; usually 1 on a hosting platform.
TRUST_PROXY=0

# ============================================================================
# FRONTEND (Astro — PUBLIC_ vars are exposed to the browser)
# ============================================================================
# Leave empty to call the API on the same origin (production: Express serves dist/)
PUBLIC_API_URL=

# Optional analytics — omit to skip tags
PUBLIC_GTM_ID=
PUBLIC_GA_ID=

# ============================================================================
# DATABASE / STORAGE
# ============================================================================
# Path to JSON data files (keep as-is for local storage)
DATA_DIR=./data

# ============================================================================
# OPTIONAL - THIRD PARTY SERVICES (Not required for basic setup)
# ============================================================================
# SendGrid API Key (alternative email service)
# SENDGRID_API_KEY=

# Google Analytics tracking ID
# GOOGLE_ANALYTICS_ID=UA-125124703-1

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# Render: most values are set by render.yaml; add the email secrets in the dashboard.
# See "Deployment" in README.md.
