# ============================================================================
# RenoFitness Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - it contains sensitive information!
# ============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
# Generate a strong secret key (minimum 32 characters)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-this-to-something-long-and-random

# JWT Token expiration (e.g., "7d", "24h", "30m")
JWT_EXPIRATION=7d

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# For Gmail:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the app password below (16 characters with spaces)

# Email provider (gmail, outlook, custom)
EMAIL_PROVIDER=gmail

# Sender email address
EMAIL_USER=your-email@gmail.com

# App-specific password (NOT your regular Gmail password!)
# For Gmail: Use the 16-character password from App Passwords
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Admin email (receives contact form submissions and can send newsletters)
ADMIN_EMAIL=RenoStudio@hotmail.com

# Email settings
EMAIL_FROM_NAME=RenoFitness
EMAIL_RATE_LIMIT=5

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Number of salt rounds for bcryptjs password hashing
BCRYPT_ROUNDS=10

# CORS allowed origins (comma-separated for production)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# DATABASE / STORAGE
# ============================================================================
# Path to JSON data files (keep as-is for local storage)
DATA_DIR=./data

# ============================================================================
# LOGGING
# ============================================================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# ============================================================================
# OPTIONAL - THIRD PARTY SERVICES (Not required for basic setup)
# ============================================================================
# SendGrid API Key (alternative email service)
# SENDGRID_API_KEY=

# Google Analytics tracking ID
# GOOGLE_ANALYTICS_ID=UA-125124703-1

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# For Heroku: Set these config vars via: heroku config:set KEY=VALUE
# For Render: Set these in the Environment tab
# For Railway: Set these in the Variables tab
# For DigitalOcean: Set in the App Platform environment section
