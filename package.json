    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.4.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
